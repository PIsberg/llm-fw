{
  "name": "llm-fw",
  "version": "0.9.3",
  "description": "Local LLM prompt injection firewall",
  "author": {
    "name": "Peter Isberg",
    "url": "https://github.com/PIsberg"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "llm-fw": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PIsberg/llm-fw.git"
  },
  "homepage": "https://github.com/PIsberg/llm-fw#readme",
  "bugs": {
    "url": "https://github.com/PIsberg/llm-fw/issues"
  },
  "keywords": [
    "llm",
    "prompt-injection",
    "firewall",
    "security",
    "proxy",
    "ai-security",
    "dlp",
    "mcp"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage --exclude test/detection/multilingual-playground.test.ts",
    "test:judge": "vitest run --config vitest.judge.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:proxy": "vitest run --config vitest.e2e.config.ts",
    "test:load:perf": "node --import tsx/esm test/load/performance.ts",
    "test:load:accuracy": "node --import tsx/esm test/load/accuracy.ts",
    "test:load": "npm run test:load:perf && npm run test:load:accuracy",
    "load:charts": "node --import tsx/esm scripts/gen-load-charts.ts",
    "scorecard": "node --import tsx/esm scripts/gen-scorecard.ts",
    "ruleset:digest": "node --import tsx/esm scripts/ruleset-digest.ts",
    "fpr": "node --import tsx/esm test/eval/fpr.ts",
    "recall:floor": "node --import tsx/esm test/eval/recallFloor.ts",
    "fuzz:rules": "node --import tsx/esm scripts/fuzz-rules.ts",
    "scan-server": "node --import tsx/esm scripts/scan-server.ts",
    "bench:competitors": "node --import tsx/esm test/eval/competitors/run.ts",
    "bench:trend": "node --import tsx/esm scripts/bench-trend.ts",
    "bench:compare": "node --import tsx/esm scripts/bench-compare.ts",
    "verdicts:dump": "node --import tsx/esm scripts/verdict-dump.ts",
    "verdicts:diff": "node --import tsx/esm scripts/verdict-diff.ts",
    "study:ml-indirect": "node --import tsx/esm scripts/study-ml-indirect.ts",
    "mutation": "stryker run",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --deny-warnings src scripts test",
    "lint:biome": "biome lint --error-on-warnings src scripts test",
    "lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:biome",
    "lint:fix": "eslint . --fix && biome lint --write src scripts test",
    "prepare": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');if(fs.existsSync('.git')&&fs.existsSync('.githooks'))try{cp.execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch{}\"",
    "knip": "knip",
    "docs:links": "node scripts/check-links.mjs",
    "fixture:multilingual": "node --import tsx/esm scripts/multilingual-fixture.ts",
    "config:reference": "node --import tsx/esm scripts/gen-config-reference.ts",
    "audit": "npm audit --audit-level=moderate",
    "perf:clinic": "npx --yes clinic@13.0.0 doctor --open=false --dest=.clinic/ -- node --import tsx/esm test/load/performance.ts",
    "scan:njsscan": "njsscan -c .njsscan .",
    "scan:snyk": "snyk test",
    "scan:socket": "socket scan"
  },
  "dependencies": {
    "@huggingface/transformers": "~4.2.0"
  },
  "//peerDependencies": "OCR is off by default (nonText.ocr), loaded through a dynamic import in src/detection/ocr.ts, and already degrades to opaque handling when the import fails. As a hard dependency it cost every install ~50 MB and 13 packages for a feature most installs never switch on. An OPTIONAL peer is the only form npm does not install by default: optionalDependencies are installed unless the user passes --omit=optional.",
  "peerDependencies": {
    "tesseract.js": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "tesseract.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "^4.9.0",
    "hyparquet": "^1.31.5",
    "knip": "^6.43.0",
    "oxlint": "^1.89.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "//overrides": "READ THIS BEFORE TRUSTING AN ENTRY HERE. npm honours `overrides` only from the ROOT project, so every entry below cleans this repo's own node_modules and CI and nothing else. Anyone who installs llm-fw as a dependency still resolves the parent's original pin. Verified with `npm install <tarball> --omit=dev --dry-run`, which still yields sharp 0.34.5, adm-zip 0.5.18 and global-agent 3.0.0. A consumer-visible fix has to come from the parent's own range, so treat a cleared `npm audit` here as a statement about this repo, not about what users install. Drop an entry once the parent's range covers the fix.",
  "overrides": {
    "qs": "^6.16.3",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5",
    "global-agent": "^4.1.3",
    "minimatch": "^11.0.1"
  }
}
