{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/dashboard/server.ts",
    "scripts/**/*.{js,mjs,ts}",
    "test/**/*.{js,mjs,ts}",
    "src/detection/inferenceWorkerEntry.ts"
  ],
  "project": [
    "src/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "update-ca-certificates",
    "pfctl",
    "iptables",
    "snyk",
    "socket",
    "njsscan"
  ]
}
